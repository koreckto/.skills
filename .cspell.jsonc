{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "words": [
    "annotationlib",
    "asyncio",
    "conftest",
    "contextlib",
    "dataclass",
    "dataclasses",
    "datetimes",
    "datetimez",
    "docstrings",
    "doctests",
    "Dunder",
    "frozendict",
    "frozenset",
    "frontmatter",
    "functools",
    "FURB",
    "isinstance",
    "isort",
    "itertools",
    "Koreckto",
    "kwargs",
    "loguru",
    "mccabe",
    "myapp",
    "negotiables",
    "nonlocal",
    "noqa",
    "noxfile",
    "pathlib",
    "Perflint",
    "pprint",
    "pycodestyle",
    "pydantic",
    "pydocstyle",
    "pyflakes",
    "pygrep",
    "Pylint",
    "pyproject",
    "pytest",
    "pyupgrade",
    "refurb",
    "setdefault",
    "splitlines",
    "structlog",
    "tombi",
    "tomllib",
    "tryceratops",
    "typeshed",
    "unitless",
    "unhashable",
    "urlsafe",
    "utcnow",
    "zstd"
  ],
  "ignorePaths": [
    ".git/**",
    ".github/**",
    ".markdownlint-cli2.jsonc",
    "LICENSE"
  ],
  "enableGlobDot": true,
  "useGitignore": true
}
