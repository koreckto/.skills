{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "words": [
    "addopts",
    "agentskills",
    "annotationlib",
    "asyncio",
    "autouse",
    "conftest",
    "contextlib",
    "dataclass",
    "dataclasses",
    "datetimes",
    "datetimez",
    "docstrings",
    "doctests",
    "Dunder",
    "elif",
    "evals",
    "expanduser",
    "frontmatter",
    "frozendict",
    "frozenset",
    "functools",
    "FURB",
    "getpgid",
    "isinstance",
    "isort",
    "itertools",
    "joinpath",
    "jsonable",
    "killpg",
    "Koreckto",
    "kwargs",
    "logfire",
    "loguru",
    "lowlevel",
    "mccabe",
    "myapp",
    "negotiables",
    "nonlocal",
    "noqa",
    "noxfile",
    "pathlib",
    "Perflint",
    "pgid",
    "pids",
    "pprint",
    "pycodestyle",
    "pydantic",
    "pydocstyle",
    "pyflakes",
    "pygrep",
    "Pylint",
    "pyproject",
    "pytest",
    "pyupgrade",
    "refurb",
    "setdefault",
    "splitlines",
    "structlog",
    "testpaths",
    "tombi",
    "tomllib",
    "tryceratops",
    "typeshed",
    "unhashable",
    "urlsafe",
    "utcnow",
    "zstd"
  ],
  "ignorePaths": [
    ".git/**",
    ".github/**",
    ".markdownlint-cli2.jsonc",
    "LICENSE",
    "**/*.lock"
  ],
  // Python source and Python-project TOML use the bundled Python dictionary.
  "languageSettings": [
    {
      "languageId": "python",
      "dictionaries": ["python"]
    },
    {
      "languageId": "toml",
      "dictionaries": ["python"]
    }
  ],
  "enableGlobDot": true,
  "useGitignore": true
}
